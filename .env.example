# Copy to .env and fill in. See SETUP.md for where each value comes from.

# --- Meta / Instagram webhook ---
# A token you invent; you type the same value into the Meta app dashboard.
META_VERIFY_TOKEN=choose-a-random-string
# App secret from the Meta app's Settings > Basic page. Enables webhook
# signature verification. Leave blank only for local development.
IG_APP_SECRET=
# Long-lived access token for the Instagram account (used to resolve a
# sender's username for the alert; optional — alerts fall back to "Someone").
IG_USER_ACCESS_TOKEN=

# --- WhatsApp Cloud API ---
# Permanent token (create a system user in Meta Business Settings).
WHATSAPP_TOKEN=
# The WhatsApp sender number's ID (WhatsApp > API Setup in the app dashboard).
WHATSAPP_PHONE_NUMBER_ID=
# Your own WhatsApp number to receive alerts, digits only, country code first.
ALERT_RECIPIENT=15145550123
# Template you create and get approved (SETUP.md). Body: two parameters.
WHATSAPP_TEMPLATE_NAME=ig_dm_alert
WHATSAPP_TEMPLATE_LANG=en

# --- Behaviour ---
TIMEZONE=America/Toronto
QUIET_START=23:00
QUIET_END=08:00
# Comma-separated sender ids or usernames to never alert for (the manual
# mirror of Instagram mute state). Seeded into the database on first run;
# afterwards manage with: python -m app.exclusions add|remove|list
EXCLUDED_SENDERS=

# --- Runtime ---
DATABASE_PATH=/data/app.db
# DRY_RUN=1 logs the WhatsApp payload instead of sending (local testing).
DRY_RUN=
